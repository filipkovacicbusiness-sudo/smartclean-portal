[Unit]
Description=SmartClean terminal za stemplanje (DESFire -> punch -> LCD)
# Brez pcscd bralnik ne obstaja — zato ga zahtevamo in počakamo nanj.
Requires=pcscd.service
After=pcscd.service network-online.target
Wants=network-online.target

[Service]
Type=simple
# Teče kot pi, ne kot root — ne potrebuje več: dostop do bralnika mu daje
# polkit pravilo (99-pcscd-pi.rules), do LCD pa članstvo v skupini i2c.
User=pi
Group=pi
# Če uporabnik ni "pi", popravi User/Group in obe poti.
ExecStart=/home/pi/stemplj-venv/bin/python /home/pi/terminal/stemplj.py
WorkingDirectory=/home/pi/terminal
# Brez tega Python izpis pod systemd zadrži v medpomnilniku in dnevnik je prazen.
Environment=PYTHONUNBUFFERED=1
Restart=always
RestartSec=3
# Brez povezave se žigi shranijo v vrsto; storitev naj se ne ustavi.
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
